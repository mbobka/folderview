<?xml version="1.0" encoding="utf-8"?>
<!--
  Настройки для zlib (распаковка ZIP-архивов).
  Библиотека устанавливается через vcpkg (manifest mode):
    vcpkg.json: "dependencies": ["zlib"]
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <VcpkgTriplet Condition="'$(Platform)'=='x64'">x64-windows</VcpkgTriplet>
    <VcpkgTriplet Condition="'$(Platform)'=='Win32'">x86-windows</VcpkgTriplet>
    <VcpkgRoot>$(MSBuildThisFileDirectory)..\vcpkg_installed\$(VcpkgTriplet)</VcpkgRoot>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(VcpkgRoot)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link Condition="'$(UseDebugLibraries)'=='true'">
      <AdditionalLibraryDirectories>$(VcpkgRoot)\debug\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>zlibd.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Link Condition="'$(UseDebugLibraries)'!='true'">
      <AdditionalLibraryDirectories>$(VcpkgRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>zlib.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- Копируем zlib DLL в выходную папку -->
  <Target Name="CopyZlibDll" AfterTargets="Build">
    <Copy Condition="'$(UseDebugLibraries)'=='true'"
          SourceFiles="$(VcpkgRoot)\debug\bin\zlibd1.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy Condition="'$(UseDebugLibraries)'!='true'"
          SourceFiles="$(VcpkgRoot)\bin\zlib1.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
