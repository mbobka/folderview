<?xml version="1.0" encoding="utf-8"?>
<!--
  Настройки для zlib (распаковка ZIP-архивов).
  Библиотека устанавливается через vcpkg (manifest mode):
    vcpkg.json: "dependencies": ["zlib"]
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VcpkgRoot>$(VSINSTALLDIR)VC\vcpkg</VcpkgRoot>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgTriplet>x64-windows</VcpkgTriplet>
    <PackageRoot>$(MSBuildThisFileDirectory)..\vcpkg_installed\$(VcpkgTriplet)\$(VcpkgTriplet)</PackageRoot>
  </PropertyGroup>
  
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.props" />
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets" />
  
  <!-- Копируем zlib DLL в выходную папку -->
  <Target Name="CopyZlibDll" AfterTargets="Build">
    <Copy Condition="'$(UseDebugLibraries)'=='true'"
          SourceFiles="$(PackageRoot)\debug\bin\zlibd1.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy Condition="'$(UseDebugLibraries)'!='true'"
          SourceFiles="$(PackageRoot)\bin\zlib1.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
